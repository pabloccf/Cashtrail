# Local PostgreSQL (docker-compose.yml). Must match the credentials in DATABASE_URL
POSTGRES_USER=USER
POSTGRES_PASSWORD=PASSWORD
POSTGRES_DB=DATABASE

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DATABASE"

# Password for the demo user created by `npx prisma db seed` and for the sample user
# created by `npm run seed:sample` (local development only)
SEED_USER_PASSWORD=

# Secret used to sign the session JWTs. Use a long random value, e.g.:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Secret the daily GitHub Action sends in the x-cron-secret header to POST /api/jobs/recurring.
# Use a long random value, generated the same way as JWT_SECRET
CRON_SECRET=
