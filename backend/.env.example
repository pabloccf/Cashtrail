# Local PostgreSQL (docker-compose.yml). Must match the credentials in DATABASE_URL
POSTGRES_USER=USER
POSTGRES_PASSWORD=PASSWORD
POSTGRES_DB=DATABASE

# Connection used by the app. In production, Neon's pooled connection (host with "-pooler")
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DATABASE"

# Connection used by the Prisma CLI (migrations). In production, Neon's direct connection.
# Optional locally: if empty or missing, DATABASE_URL is used
# DIRECT_URL=

# Password for the demo user created by `npx prisma db seed` and for the sample user
# created by `npm run seed:sample` (local development only)
SEED_USER_PASSWORD=

# Secret used to sign the session JWTs. Use a long random value, e.g.:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Public URL of the frontend. Google sends the user back to APP_URL/api/auth/google/callback,
# and after signing in the backend redirects to pages under it.
# Locally it is Vite's address (its proxy forwards /api to the backend); in production, the Vercel domain
APP_URL=http://localhost:5173

# OAuth client of the Google Cloud project ("Web application" type). Sign in with Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Secret the daily GitHub Action sends in the x-cron-secret header to POST /api/jobs/recurring.
# Use a long random value, generated the same way as JWT_SECRET
CRON_SECRET=
