generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TransactionType {
  EXPENSE
  INCOME
}

// PENDING records come from CONFIRM-mode recurring transactions and do not count in totals until confirmed
enum TransactionStatus {
  CONFIRMED
  PENDING
}

enum Frequency {
  MONTHLY
  YEARLY
}

// AUTO: records are created as CONFIRMED. CONFIRM: records are created as PENDING
enum RecurringMode {
  AUTO
  CONFIRM
}

// External identity providers a user can sign in with. Only Google for now
enum AuthProvider {
  GOOGLE
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  // Null for users who signed up with Google and never created a password
  passwordHash String?
  name         String
  currency     String   @default("EUR") @db.Char(3)
  createdAt    DateTime @default(now()) @db.Timestamptz

  authAccounts          AuthAccount[]
  categories            Category[]
  transactions          Transaction[]
  recurringTransactions RecurringTransaction[]
  budgets               Budget[]
}

// Links a user to their account in an external provider (e.g. their Google account)
model AuthAccount {
  id                String       @id @default(uuid()) @db.Uuid
  userId            String       @db.Uuid
  provider          AuthProvider
  // The provider's permanent id for the person (Google's `sub`). The email can change, this never does,
  // so sign-in always looks the user up by this field and never by email
  providerAccountId String
  createdAt         DateTime     @default(now()) @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // A Google account belongs to one user only
  @@unique([provider, providerAccountId])
  // A user has at most one account per provider. It also serves as the index for "accounts of a user"
  @@unique([userId, provider])
}

model Category {
  id     String          @id @default(uuid()) @db.Uuid
  userId String          @db.Uuid
  name   String
  color  String // Hex color, e.g. "#22c55e"
  icon   String // Icon name used by the frontend
  type   TransactionType

  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions          Transaction[]
  recurringTransactions RecurringTransaction[]
  budgets               Budget[]

  @@unique([userId, type, name])
}

model Transaction {
  id                     String            @id @default(uuid()) @db.Uuid
  userId                 String            @db.Uuid
  categoryId             String            @db.Uuid
  // Set when the record was generated from a recurring transaction. Null for manual records
  recurringTransactionId String?           @db.Uuid
  amount                 Int // In cents, always positive. The sign comes from `type`
  description            String?
  date                   DateTime          @db.Date
  type                   TransactionType
  status                 TransactionStatus @default(CONFIRMED)
  createdAt              DateTime          @default(now()) @db.Timestamptz

  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  category             Category              @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  // Deleting the recurring transaction keeps its records in the history, just unlinked
  recurringTransaction RecurringTransaction? @relation(fields: [recurringTransactionId], references: [id], onDelete: SetNull)

  // A recurring transaction generates at most one record per day, so running the job twice
  // never duplicates anything. Manual records (null) never collide: in PostgreSQL NULLs are all distinct
  @@unique([recurringTransactionId, date])
  @@index([userId, date])
  @@index([categoryId])
}

// Template from which the daily job creates records (Spotify, car loan, salary...).
// It only creates entries in the app: it never pays or charges anything
model RecurringTransaction {
  id              String          @id @default(uuid()) @db.Uuid
  userId          String          @db.Uuid
  categoryId      String          @db.Uuid
  amount          Int // In cents, always positive. The sign comes from `type`
  description     String
  type            TransactionType
  frequency       Frequency
  dayOfMonth      Int // 1-31. If the month is shorter, the last day of the month is used
  monthOfYear     Int? // 1-12. Only for YEARLY, null for MONTHLY
  startDate       DateTime        @db.Date
  endDate         DateTime?       @db.Date // Null means it never ends
  mode            RecurringMode
  active          Boolean         @default(true)
  // Last day the job has already processed. Null until the first run
  lastGeneratedAt DateTime?       @db.Date
  createdAt       DateTime        @default(now()) @db.Timestamptz

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  transactions Transaction[]

  @@index([userId])
  @@index([categoryId])
}

// Monthly spending limit for one expense category. Only a reference to compare against:
// it never blocks or changes any record
model Budget {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  categoryId String   @db.Uuid
  amount     Int // In cents, always positive
  month      Int // 1-12
  year       Int
  createdAt  DateTime @default(now()) @db.Timestamptz

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Restrict: a category with budgets cannot be deleted (the service answers 409 before reaching this)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  // One budget per category and month. It also serves as the index for "budgets of a month of a user"
  @@unique([userId, categoryId, month, year])
  @@index([categoryId])
}
